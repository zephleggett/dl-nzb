<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dl-nzb, Direct flavour (Developer ID, Sparkle). The App Store flavour's
  sandbox, plus the two Mach services Sparkle's Installer Launcher uses from
  inside the sandbox (sparkle-project.org/documentation/sandboxing). Xcode
  expands $(PRODUCT_BUNDLE_IDENTIFIER); scripts/sign.sh does the same when it
  signs a release. No Downloader service: the app has network.client.
  Keep dl-nzb.entitlements and dl-nzb-Direct-AdHoc.entitlements in step.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
